<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- DPI awareness is declared in app.manifest (the WPF way); silence the WinForms analyzer. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Screenish.ico</ApplicationIcon>
    <AssemblyName>Screenish</AssemblyName>
    <RootNamespace>Screenish</RootNamespace>
    <Product>Screenish</Product>
    <Company>Thomas Strömberg</Company>
    <Copyright>Thomas Strömberg</Copyright>

    <!-- App version (semver X.Y.Z): bumped by hand before each release, kept in
         step with MARKETING_VERSION of the macOS client. See CLAUDE.md. -->
    <Version>1.3.1</Version>
    <!-- Build number = git commit count, injected by scripts/export-release.ps1
         (-p:BuildNumber=N). The placeholder 1 only applies to plain dev builds. -->
    <BuildNumber Condition="'$(BuildNumber)' == ''">1</BuildNumber>
    <FileVersion>$(Version).$(BuildNumber)</FileVersion>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <InformationalVersion>$(Version)+$(BuildNumber)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF + WinForms together make these ambiguous (Application, Color, …). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Resource Include="Assets\Screenish.ico" />
    <Resource Include="Assets\AppIcon256.png" />
  </ItemGroup>

</Project>
